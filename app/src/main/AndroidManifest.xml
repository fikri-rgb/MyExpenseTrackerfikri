<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.informatika.myexpensetrackerfikri">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="My Expense Tracker"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- ExpenseListActivity sebagai halaman utama -->
        <activity
            android:name=".expense.ExpenseListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Activity lainnya -->
        <activity android:name=".MainActivity" android:exported="false"/>
        <activity android:name=".expense.AddEditExpenseActivity" android:exported="false"/>

    </application>
</manifest>
